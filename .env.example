# =============================================================================
# Nodemaru Visual Composer - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control!
# =============================================================================

# Database Configuration
# Path to SQLite database file (relative to api/ folder or absolute path)
DB_PATH="presets.sqlite"

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain/api/auth.php?action=google_callback

# Application Settings
APP_NAME="Nodemaru Visual Composer"
PASSWORD_MIN_LENGTH=6
SESSION_LIFETIME=172800
